<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Практикум: Kotlin Coroutines"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Start (Важкі обчислення)" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="1. Cancel (Скасувати обчислення)" />

    <Button
        android:id="@+id/btnTestCrash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="2. Test Crash (Звичайний Job)" />

    <Button
        android:id="@+id/btnSupervisorScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="3. SupervisorScope (Ізоляція помилок)" />

    <Button
        android:id="@+id/btnGlobalCrash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Global Crash (CoroutineExceptionHandler)" />

</LinearLayout>